# Пример переменных окружения. Скопируйте в .env и задайте собственные значения.
# Реальные секреты в репозиторий не добавляются.

POSTGRES_USER=station
POSTGRES_PASSWORD=station_dev_password
POSTGRES_DB=station

# Учётные данные MQTT: у сервиса приёма и у симулятора они разные (разные права на топики).
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=ingest_dev_password
MQTT_SIM_USER=simulator
MQTT_SIM_PASSWORD=simulator_dev_password

# Токен внутреннего канала «эталонного мира» симуляции (только для контейнера simulator).
SIM_WORLD_TOKEN=sim_world_dev_token

# Ключ подписи токенов пользователей.
SECRET_KEY=change_me_dev_secret

# Конфигурация основной станции: large (Алматы, демо) или small (Шамалган, демо).
STATION_CONFIG=large

# Необязательный адаптер внешней языковой модели. Пусто — объяснения по шаблонам.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Хранение истории
TELEMETRY_RETENTION_HOURS=48
REPLAY_RETENTION_MINUTES=60

# Порты на хосте
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
MQTT_PORT=1883
